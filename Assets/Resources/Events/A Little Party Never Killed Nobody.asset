    RequiredBuilding: 0
    RequiredResourceType: 0
    RequiredResourceAmount: 0
  - Label: Not a chance
    Explanation: Hope falls
    ChangesHope: 1
    HopeChange: -10
    Requirements: []
    Rewards: []
    RequirementType: 0
    RequiredBuilding: 0
    RequiredResourceType: 0
    RequiredResourceAmount: 0
